{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/dashboard.html",
        "destination": "/index.html"
      },
      {
        "source": "/analytics.html",
        "destination": "/index.html"
      },
      {
        "source": "/expenses.html",
        "destination": "/index.html"
      },
      {
        "source": "/portfolio.html",
        "destination": "/index.html"
      },
      {
        "source": "/knight-os.html",
        "destination": "/index.html"
      },
      {
        "source": "/knight-os-mindmap.html",
        "destination": "/index.html"
      },
      {
        "source": "/login.html",
        "destination": "/index.html"
      },
      {
        "source": "/register.html",
        "destination": "/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
